// Prices (price, mrp) are stored as integer paise (₹499.50 → 49950)
// because Prisma's MongoDB connector has no Decimal type and floats
// are unsafe for money. Format at the UI layer only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum StockStatus {
  IN_STOCK
  LOW
  OUT_OF_STOCK
}

enum CustomerStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  BLOCKED
}

enum RequestStatus {
  PENDING
  // Skipped for now — parked in the "Later" tab, out of the pending queue
  // and its badge, still counted as an OPEN request everywhere else.
  SNOOZED
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
}

// ── GST / tax (Phase 13) ──────────────────────────────────────────────────
// How a stored price relates to GST. EXCLUSIVE: the stored paise is the
// taxable base and GST is added on top. INCLUSIVE: the stored paise already
// contains GST (MRP-style) and the base is back-computed.
enum TaxTreatment {
  TAX_EXCLUSIVE
  TAX_INCLUSIVE
}

// Intra-state supply → CGST + SGST; inter-state → IGST. Decided server-side
// from the seller's state vs the customer's place of supply.
enum SupplyType {
  INTRA
  INTER
}

// GST rounding policy: per-line (default, standard on invoices) or a single
// invoice-level round-off to the nearest rupee.
enum RoundingMode {
  LINE
  INVOICE
}

// How prices are shown to retailers by default (independent of storage).
enum PriceDisplayMode {
  INCLUSIVE
  EXCLUSIVE
}

model Category {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String       @unique
  image     String?
  sortOrder Int          @default(0)
  status    EntityStatus @default(ACTIVE)
  // GST (Phase 13): category-level defaults inherited by products that don't
  // set their own. gstRateBps is basis points (1800 = 18.00%).
  defaultHsnCode    String?
  defaultGstRateBps Int?
  // Default allocation config inherited by products with allocation = null
  // (same inheritance idea as the GST defaults above).
  defaultAllocation Json?
  parentId  String?      @db.ObjectId
  parent    Category?    @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Category[]   @relation("SubCategories")
  products  Product[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, sortOrder])
}

// Images are embedded in the product document (Mongo-idiomatic:
// they are always loaded and saved together with the product).
type ProductImage {
  url       String
  thumbUrl  String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)
}

model Product {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  categoryId  String         @db.ObjectId
  category    Category       @relation(fields: [categoryId], references: [id])
  name        String
  slug        String         @unique
  sku         String         @unique
  // Legacy free-text brand, retained during the Brand-master migration.
  brand       String?
  brandId     String?        @db.ObjectId
  brandRef    Brand?         @relation(fields: [brandId], references: [id])
  description String?
  specs       Json?
  price       Int // paise
  mrp         Int? // paise
  moq         Int?
  // Order in multiples of this (boxes/packs): MOQ 10 + packMultiple 10 ⇒
  // 10, 20, 30… while MOQ 10 + null ⇒ any qty ≥ 10. null/1 = no constraint.
  packMultiple Int?
  // Per-line quantity ceiling the admin sets; null ⇒ the platform default
  // (200). Admin-defined always wins, in either direction.
  maxQty      Int?
  // Customers may attach a requirement note + photos to this product's cart
  // line (long model lists for tempered glass etc.). Admin-controlled.
  allowRequirementNotes Boolean?
  // GST (Phase 13): optional per-product override; null ⇒ inherit the
  // category default, then the SellerTaxProfile default. gstRateBps is basis
  // points (1800 = 18.00%). taxTreatment null ⇒ inherit the profile mode.
  hsnCode      String?
  gstRateBps   Int?
  taxTreatment TaxTreatment?
  stockStatus StockStatus    @default(IN_STOCK)
  status      EntityStatus   @default(ACTIVE)
  tags        String[]       @default([])
  images      ProductImage[]
  pageViews   PageView[]
  wishlistedBy WishlistItem[]
  cartItems   CartItem[]
  // Variants (opt-in per product). When hasVariants is false the product
  // behaves exactly as before: `price`/`mrp`/`stockStatus`/`sku` are authoritative
  // and there are no ProductVariant rows. When true, `price` is the denormalized
  // "from" (min active variant) for list/sort, and each ProductVariant carries
  // its own price/sku/stock. optionTypes is the embedded axis definition
  // (e.g. [{ name: "Capacity", values: ["10000mAh","20000mAh"] }]).
  hasVariants Boolean          @default(false)
  // Admin override for the Trending rail: a set timestamp FORCES this product
  // into Trending (pinned first, newest pin first) regardless of the algo;
  // absent/null = algo decides. Timestamp, not boolean, so pins order
  // deterministically and "unpin" is just clearing it.
  // Indexed: the home page reads pins FRESH on every render (so an admin's
  // pin shows up immediately), which without an index is a full product scan
  // on the hottest page in the app.
  trendingPinnedAt DateTime?
  optionTypes Json?
  // Per-model quantity allocation (screen protectors etc.). Shape:
  //   { kind: "DEVICE_MODEL", required: boolean, modelIds: string[] }
  // null ⇒ inherit the category's defaultAllocation; explicit required:false
  // ⇒ override the category OFF. Empty modelIds ⇒ every ACTIVE model allowed.
  allocation Json?
  variants    ProductVariant[]
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId, status])
  @@index([deletedAt])
  @@index([brandId])
  @@index([trendingPinnedAt])
  // Hot storefront listing: filter {status, deletedAt} sorted by createdAt.
  @@index([status, deletedAt, createdAt])
}

model Customer {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  businessName String
  contactName  String
  phone        String          @unique
  passwordHash String
  email        String?
  gstNumber    String?
  // GST (Phase 13): 2-digit state code parsed from a validated GSTIN, and the
  // explicit place of supply (billing state). GSTIN state wins for registered
  // buyers; unregistered buyers fall back to placeOfSupplyStateCode.
  gstStateCode           String?
  placeOfSupplyStateCode String?
  city         String?
  status       CustomerStatus  @default(PENDING)
  notes        String?
  accessGrants AccessGrant[]
  requests     AccessRequest[]
  sessions     Session[]
  pageViews    PageView[]
  wishlist     WishlistItem[]
  cartItems    CartItem[]
  orders       Order[]
  // Per-person notification preferences (muted topic list). Parsed
  // defensively in src/lib/notify/prefs.ts; absent => topic defaults.
  notifyPrefs  Json?
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
}

// ── Google sign-in (storefront) ────────────────────────────────────────────

// A customer's Google identity link. Separate table (not columns on Customer)
// so Customer's index landscape is untouched; `sub` is Google's stable id.
model GoogleAccount {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  sub        String   @unique
  customerId String   @db.ObjectId
  email      String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Single-use server-side rows carrying the OAuth flow (PKCE verifier + nonce)
// and the post-auth signup handoff (verified email → request-access form).
// Never cookies: single-use + TTL enforced at read, atomic claim on use.
model OAuthFlowState {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  token        String    @unique
  kind         String // "state" | "signup"
  pkceVerifier String?
  nonce        String?
  email        String?
  name         String?
  sub          String?
  returnTo     String?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
}

model AccessGrant {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId String    @db.ObjectId
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  approvedAt DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  grantedBy  String

  @@index([customerId, expiresAt])
}

/// Billing group: an admin-configured bucket a cart is split into (by brand
/// today), with rules (tiered discount) run on the bucket and its own bill page.
/// Runtime-editable — no deploy to change brands / tiers / switch off. Carts are
/// NOT stored per group: buckets are derived at read time from these rows, and
/// orders freeze a snapshot (Order.billingGroups) so history never shifts.
/// `matcher` and `rules` are tagged-union JSON (see src/lib/billing-groups/types.ts).
model BillingGroup {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  code           String   @unique
  color          String   @default("blue")
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  matcher        Json
  rules          Json
  separateBill   Boolean  @default(true)
  couponStacking Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
}

model AccessRequest {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  customerId String        @db.ObjectId
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status     RequestStatus @default(PENDING)
  // True when filed by an ALREADY-KNOWN customer re-requesting lapsed access
  // (owner request): the admin queue shows these as "Renewal".
  renewal    Boolean       @default(false)
  // A "connect my Google sign-in" request. Set when someone signs in with
  // Google and enters the phone number of an EXISTING customer whose account
  // is not linked to that Google identity. A typed phone number proves
  // nothing, so we never link on it automatically — the admin approves, and
  // approval performs the link. Until then these stay unusable.
  linkGoogleSub   String?
  linkGoogleEmail String?
  reason     String?
  decidedAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, createdAt])
}

// An admin/staff user. Access is governed by the assigned Role's permissions.
model Admin {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  email        String    @unique
  passwordHash String
  totpSecret   String?
  name         String
  isActive     Boolean   @default(true)
  roleId       String?   @db.ObjectId
  role         Role?     @relation(fields: [roleId], references: [id])
  // Per-person notification preferences — see src/lib/notify/prefs.ts.
  notifyPrefs  Json?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]

  @@index([roleId])
}

// A named set of permissions (RBAC). Permission keys are free-form strings from
// a central catalog (see src/lib/permissions.ts), so access is fully
// configurable. `isSystem` marks built-in roles (e.g. Owner) that cannot be
// deleted and always retain full access.
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  admins      Admin[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String    @unique
  customerId String?   @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminId    String?   @db.ObjectId
  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([customerId])
  @@index([adminId])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  actorType String
  actorId   String
  action    String
  entity    String
  entityId  String
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  // The daily nudge cron (/api/cron/notify) dedupes by asking "did we already
  // send this milestone?" as `type in (...) AND createdAt >= cutoff` — one
  // query per run. Without this index that read is a full collection scan.
  @@index([type, createdAt])
}

// Web Push subscriptions (admin devices) — populated when an admin enables
// push in the PWA; consumed by src/server/notify/push.ts to send alerts.
// ── Contact-us messages (public, Google-verified visitors) ──────────────────
// These people are NOT customers: the form requires a Google sign-in + phone
// + reason, and the same Google account may write at most 3 messages ever
// (anti-misuse, owner request). Staff read and action them in the admin panel.
model ContactMessage {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  // Google identity of the sender (verified in the OAuth callback).
  googleSub  String
  email      String
  name       String?
  phone      String
  businessName String?
  city       String?
  // Why they are contacting — mandatory, the whole point of the form.
  reason     String
  // NEW → staff have not acted; DONE → handled (kept for the audit trail).
  status     String    @default("NEW")
  handledAt  DateTime?
  handledBy  String?   @db.ObjectId
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([googleSub])
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  adminId   String?  @db.ObjectId
  // Web Push now serves BOTH audiences. "admin" | "customer" — a device is
  // only ever sent notifications addressed to its own audience, so a buyer's
  // browser can never receive an internal staff alert.
  audience   String   @default("admin")
  // Set for audience="customer": the buyer this device belongs to.
  customerId String?  @db.ObjectId
  userAgent String?
  // Refreshed on every re-subscribe; lets us prune devices that went quiet.
  lastSeenAt DateTime?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([audience])
  @@index([customerId])
}

model PageView {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId String?   @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  productId  String    @db.ObjectId
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([customerId, createdAt])
  // Trending scores a time WINDOW across all products, so it filters on
  // createdAt alone — which neither compound index above can serve (a
  // compound index needs its LEADING field named). Without this the scorer
  // scanned the whole collection every 15 minutes.
  @@index([createdAt])
}

model Brand {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String       @unique
  slug      String       @unique
  logo      String?
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  products  Product[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, sortOrder])
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  note       String?
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

// A specific purchasable variant of a Product (e.g. "20000mAh · Black").
// Only present when the parent Product.hasVariants is true. Price is integer
// paise, gated exactly like Product.price.
model ProductVariant {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  productId    String       @db.ObjectId
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String       @unique
  // Chosen value per option axis, e.g. { "Capacity": "20000mAh", "Color": "Black" }.
  optionValues Json
  price        Int // paise
  mrp          Int? // paise
  moq          Int?
  // Pack multiple override; null ⇒ inherit the parent product's.
  packMultiple Int?
  // Max-qty override; null ⇒ inherit the parent product's.
  maxQty       Int?
  // GST (Phase 13): per-variant override; null ⇒ inherit the parent product.
  hsnCode      String?
  gstRateBps   Int?
  taxTreatment TaxTreatment?
  stockStatus  StockStatus  @default(IN_STOCK)
  status       EntityStatus @default(ACTIVE)
  images       ProductImage[]
  isDefault    Boolean      @default(false)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([productId, status])
}

// A line in an approved customer's cart. One row per (customer, product,
// variant). Quantity is validated server-side (>= MOQ, <= caps). Prices are
// NEVER stored here — they are computed server-side at placement from the
// gated DAL, so a client can't manipulate them.
model CartItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?  @db.ObjectId
  quantity   Int
  // Per-model quantity split for allocation products: [{ modelId, qty }],
  // validated server-side to sum EXACTLY to `quantity`. null for normal lines.
  breakdown  Json?
  // Requirement note + photo attachments (customer-supplied, only on products
  // with allowRequirementNotes): note ≤ 1000 chars; attachments =
  // [{ url }] (≤ 6, minted through OUR presign — never arbitrary URLs).
  note        String?
  attachments Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId, variantId])
  @@index([customerId])
}

// A placed order (a purchase request — no payment collected). `items` is a
// server-computed snapshot (name/sku/brand/variant/qty/unitPricePaise/lineTotal)
// so later catalog changes don't alter the order. orderNumber is a random,
// non-enumerable public reference.
model Order {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber   String      @unique
  customerId    String      @db.ObjectId
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status        OrderStatus @default(PLACED)
  // Set ONCE when the order transitions to FULFILLED (the "completed"
  // moment shown to admins). updatedAt can't serve this — it moves on any
  // later edit (tracking, notes), which would silently rewrite history.
  fulfilledAt   DateTime?
  items         Json
  subtotalPaise Int
  itemCount     Int
  note          String?
  adminNote     String?
  // Coupon (Phase: coupons port) — frozen at placement. discountPaise is the
  // order-level discount taken off the goods subtotal (never negative totals).
  couponCode    String?
  discountPaise Int?
  // GST (Phase 13): tax snapshot frozen at placement (rates change; a placed
  // order must not). Per-line tax lives inside `items`; these are the
  // order-level totals + supply context. All *Paise are integer paise.
  // gstEnabled=false at placement ⇒ these stay null and the order behaves
  // exactly as a pre-GST order (subtotalPaise is the total).
  taxApplied             Boolean     @default(false)
  supplyType             SupplyType?
  placeOfSupplyStateCode String?
  sellerStateCode        String?
  sellerGstin            String?
  totalTaxablePaise      Int?
  totalCgstPaise         Int?
  totalSgstPaise         Int?
  totalIgstPaise         Int?
  totalTaxPaise          Int?
  roundOffPaise          Int?
  grandTotalPaise        Int?
  // Group-by-(hsn,rate) summary rows for the invoice layout.
  hsnSummary             Json?
  // Billing groups (owner request): the total of every bucket's tiered discount,
  // and the FROZEN bucket snapshot (src/lib/billing-groups/snapshot.ts). Both
  // absent on orders placed before the feature or with only the General bucket,
  // so old orders render exactly as before. `subtotalPaise` stays PRE-discount.
  groupDiscountPaise Int?
  billingGroups      Json?
  // Delivery disclosure FROZEN at placement (src/lib/delivery.ts); absent on
  // orders placed before the feature or while it was off.
  deliveryDisclosure Json?
  // The delivery CHARGE actually collected on this order (integer paise),
  // frozen at placement. A CHARGE, not goods: it sits OUTSIDE `subtotalPaise`,
  // outside every discount and outside the GST taxable base, and is added last
  // to reach the payable total. ABSENT on orders placed before delivery became
  // a real money line — every reader treats missing as 0, so those orders keep
  // their exact historical total.
  deliveryChargePaise Int?
  // Set when placing this order AUTO-EXTENDED the customer's access (the
  // +30-days reward). Lets the admin see it and ROLL IT BACK on cancellation
  // (anti-abuse: junk orders to farm access). {days, previousExpiresAt,
  // expiresAt, retractedAt?}
  accessExtension    Json?
  // Courier tracking the admin attaches once the parcel ships:
  // { courierName?, trackingId?, url? } — parsed defensively in
  // src/lib/tracking.ts. Absent for unshipped/legacy orders.
  tracking           Json?
  placedAt      DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId, placedAt])
  @@index([status, placedAt])
}

// ── Seller tax profile (Phase 13) ─────────────────────────────────────────
// A single settings document for the wholesaler's GST configuration. There is
// exactly one row (a fixed `key`); the service upserts it. When `gstEnabled`
// is false the whole GST feature is inert and the app behaves exactly as
// pre-GST (no tax figures anywhere), which is the safe default at launch.
model SellerTaxProfile {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  key               String           @unique @default("default")
  gstEnabled        Boolean          @default(false)
  gstin             String?
  legalName         String?
  stateCode         String? // 2-digit place-of-supply origin
  priceEntryMode    TaxTreatment     @default(TAX_EXCLUSIVE)
  displayMode       PriceDisplayMode @default(EXCLUSIVE)
  roundingMode      RoundingMode     @default(LINE)
  defaultGstRateBps Int              @default(1800) // 18.00%
  defaultHsnCode    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// ── Store settings ──────────────────────────────────────────────────────────
// A single settings document for order-flow configuration (the SellerTaxProfile
// pattern): exactly one row (fixed `key`), upserted on first read. Extend this
// model for future store-wide knobs instead of adding new singletons.
model StoreSettings {
  id  String @id @default(auto()) @map("_id") @db.ObjectId
  key String @unique @default("default")
  // Minimum order value in integer paise. null/0 = no minimum (feature off).
  minOrderValuePaise Int?
  // "Built with Slaby" branding placements (owner-toggleable). Tagged JSON
  // parsed defensively in src/lib/slaby/branding.ts; absent => everything OFF.
  slabyBranding      Json?
  // Delivery rules (min charge disclosure) — src/lib/delivery.ts; absent => OFF.
  deliveryRules      Json?
  // Entry gate (shop code required before requesting access) —
  // src/lib/entry-gate.ts; absent => OFF.
  entryGate          Json?
  // Free-text notice under the cart's order summary (owner-editable copy,
  // e.g. which brands are billed with GST). null/empty => nothing shown.
  cartNotice         String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Device models (allocation master) ───────────────────────────────────────
// The master list of phone/device models that per-model quantity breakdowns
// reference (e.g. tempered glass: "10 × Realme 11, 10 × S23 Ultra"). Managed
// like the Brand master: admin CRUD + bulk paste, ACTIVE/INACTIVE lifecycle.
// Deactivate rather than delete once orders/carts reference a model.
model DeviceModel {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String       @unique
  slug      String       @unique
  // Grouping label for the picker ("Samsung", "Realme"); free text on purpose.
  brandName String?
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, sortOrder])
  @@index([brandName])
}

// ── Coupons (ported from the tradeOS design) ─────────────────────────────
// Codes are stored UPPERCASE and globally unique. PERCENT takes basis points
// (500 = 5%), FIXED takes integer paise; exactly one of the two is set.
// Redemption is claimed ATOMICALLY at placement (conditional increment), so a
// nearly-exhausted code can never over-redeem under concurrency.

enum CouponKind {
  PERCENT
  FIXED
}

model Coupon {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  code             String     @unique
  kind             CouponKind
  // PERCENT: basis points off the subtotal (500 = 5%). Null for FIXED.
  valueBps         Int?
  // FIXED: integer paise off the subtotal. Null for PERCENT.
  amountPaise      Int?
  minOrderPaise    Int        @default(0)
  startsAt         DateTime?
  expiresAt        DateTime?
  // Global redemption cap; null = unlimited.
  maxRedemptions   Int?
  redemptionCount  Int        @default(0)
  // Per-customer redemption cap (counted from prior orders); null = unlimited.
  perCustomerLimit Int?
  // Product scoping: when non-empty the coupon applies ONLY to these products
  // — the discount computes on (and allocates across) the eligible lines.
  productIds       String[]   @default([])
  active           Boolean    @default(true)
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([active, deletedAt])
}
